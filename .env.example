# ═══════════════════════════════════════════════
#  HelpDesk API — Variables de entorno
#  Copia este archivo como .env y ajusta los valores
#  NUNCA subas .env a git — agrega .env a .gitignore
# ═══════════════════════════════════════════════

# ── Base de datos ───────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=helpdesk
DB_USER=helpdesk_user
DB_PASSWORD=tu_password_seguro

# ── JWT ─────────────────────────────────────────
# Genera una clave segura con: openssl rand -hex 32
SECRET_KEY=cambia_esta_clave_por_una_segura_de_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Aplicación ──────────────────────────────────
APP_ENV=development
APP_NAME=HelpDesk API
APP_VERSION=1.0.0

# ── CORS ────────────────────────────────────────
# En producción reemplaza con tu dominio real
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Archivos ────────────────────────────────────
MEDIA_DIR=./media
MAX_FILE_SIZE_MB=10
# MIME types permitidos para evidencias (separados por coma)
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
